node_modules/
dist/

# Bubblewrap / Android build output. The keystore especially must never be
# committed — losing it means you cannot ship updates under the same identity,
# and leaking it means someone else can.
*.keystore
*.jks
*.apk
*.aab
twa-manifest.json.bak
.bubblewrap/

# Build/deploy archives. dist/ is generated by scripts/build.js; a zip of it
# is an artefact, not a source. One was committed here for months and is what
# AUDIT.md and HANDOFF.md both flagged and neither removed.
*.zip
